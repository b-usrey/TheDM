# Copy this file to .env and fill in real values -- .env itself is
# gitignored and must never be committed.

# Signs Flask's session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MAPGEN_SECRET_KEY=

# The standing invite code everyone signs up with. Leave blank to make
# signup open to anyone who can reach the server (fine for local testing,
# not recommended once it's exposed to the internet).
MAPGEN_INVITE_CODE=

# The one username allowed to see /admin (list/delete accounts, mint
# single-use invite codes). Must match an account you actually create.
MAPGEN_ADMIN_USERNAME=
